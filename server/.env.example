# ── Required ─────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# Postgres with the pgvector extension available. On Supabase: Project Settings ->
# Database -> Connection string -> "Transaction pooler" (IPv4, recommended for apps).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# ── Models ───────────────────────────────────────────────────────────────────
# LEDGER_CHAT_MODEL=gpt-4o
# LEDGER_EMBED_MODEL=text-embedding-3-small
# Embedding width. MUST match the vector(N) column in store.SCHEMA. Changing the embed
# model to one of a different dimensionality is a schema migration, not just an env flip.
# LEDGER_EMBED_DIM=1536

# OpenAI calls sit in the request path; these bound them (SDK default timeout is 10 min).
# LEDGER_OPENAI_TIMEOUT=30
# LEDGER_OPENAI_MAX_RETRIES=2
# LEDGER_SEED=7                         # fixed seed for reproducible extraction/reconcile calls

# ── Write path: reconciliation ───────────────────────────────────────────────
# Below this cosine similarity a candidate is a deterministic ADD (nothing close enough
# to reconcile against). There is deliberately no symmetric high-similarity auto-NOOP.
# LEDGER_SIM_ADD_BELOW=0.55
# How many neighbours a candidate is reconciled against. A CORRECTNESS knob, not a cost
# one: a contradiction ranked outside this window is never adjudicated (see memory.py).
# LEDGER_NEIGHBOR_FETCH=20
# Per-customer ceiling on the only unbounded category (episode); oldest-first eviction.
# LEDGER_MAX_EPISODES=200

# ── Read path: retrieval + blended rerank ────────────────────────────────────
# Candidate pool handed to the reranker. A safety valve, not a quality knob: set so it
# does not bind for a real customer, so the blend ranks every fact they have.
# LEDGER_RERANK_FETCH=500
# LEDGER_RELEVANCE_FLOOR=0.20           # min cosine to count as on-topic (keyword hits bypass)
# LEDGER_W_RELEVANCE=1.0                # blend weights: relevance dominates, the rest nudge
# LEDGER_W_IMPORTANCE=0.35
# LEDGER_W_RECENCY=0.20
# LEDGER_W_LEXICAL=0.25
# LEDGER_RECENCY_HALFLIFE_DAYS=45       # age at which the recency signal has halved

# ── Server ───────────────────────────────────────────────────────────────────
# LEDGER_LOG_LEVEL=INFO
# UI_DIST=../ui/dist                    # built UI served as static files if present
